# ---- Server ----
PORT=8080
# Comma-separated allowed frontend origins (add your Vercel URL in production)
CORS_ORIGINS=http://localhost:5173
# TMP_DIR=/tmp/clipflow

# ---- Limits ----
MAX_UPLOAD_MB=200
JOB_TTL_MINUTES=30
PROCESS_TIMEOUT_MS=300000
RATE_LIMIT_PER_15MIN=200
HEAVY_RATE_LIMIT_PER_15MIN=30

# ---- FFmpeg (defaults work if ffmpeg/ffprobe are on PATH) ----
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- Direct file links (user-owned MP4/WebM/MOV URLs), SSRF-protected ----
ALLOW_DIRECT_URLS=true

# ---- Optional platform credentials ----
# YouTube Data API v3 key: adds duration to YouTube inspection
YOUTUBE_API_KEY=
# Meta token "APP_ID|CLIENT_TOKEN": enables Facebook oEmbed Video metadata (needs Meta oEmbed Read approval)
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v21.0

# ---- Optional AI (server-side only, never exposed to the frontend) ----
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1
